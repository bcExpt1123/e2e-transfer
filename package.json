{
  "name": "e2e-transfer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @e2e-transfer/web dev",
    "build": "pnpm --filter @e2e-transfer/web build",
    "preview": "pnpm --filter @e2e-transfer/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tests/e2e",
    "deps:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "size": "size-limit",
    "check": "pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test && pnpm build && pnpm size",
    "prepare": "lefthook install || true"
  },
  "size-limit": [
    {
      "name": "initial JS",
      "path": "apps/web/dist/assets/*.js",
      "limit": "90 KB",
      "gzip": true
    },
    {
      "name": "initial CSS",
      "path": "apps/web/dist/assets/*.css",
      "limit": "15 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "lefthook": "2.2.2",
    "size-limit": "14.3.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
